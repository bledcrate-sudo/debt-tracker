generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  currency  String   @default("USD")
  // Manual correction folded into the running balance (e.g. to match your
  // real bank balance) without needing an Income entry. Applied once, at
  // the start of the ledger, and carried forward through every month.
  balanceAdjustment Float @default(0)
  createdAt DateTime @default(now())
  entries   Entry[]
  plaidItems PlaidItem[]
  simplefinConnections SimplefinConnection[]
}

model Entry {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // "income" | "expense" (bills) | "purchase" | "debt"
  label     String
  amount    Float
  frequency String    @default("once") // "once" | "monthly"
  apr        Float?   // annual interest rate %, debts only
  minPayment Float?   // required minimum monthly payment, debts only
  dueDay     Int?     // day of month payment is due (1-31), debts only
  // Purchases/one-off bills only: where the money came from. null behaves as "balance".
  // Circulation entries (bank-imported, type "circulation") reuse it for direction.
  sourceKind  String? // "balance" | "off" | "debt"; circulation: "in" | "out"
  debtEntryId String? // the card/loan it went on, when sourceKind is "debt"
  debtEntry   Entry?  @relation("EntryCharge", fields: [debtEntryId], references: [id], onDelete: SetNull)
  // Reverse side: purchases/bills charged to this debt. Deleting the debt
  // just clears their debtEntryId above rather than failing or cascading.
  chargedEntries Entry[] @relation("EntryCharge")
  chargeId    String? // the DebtPayment charge raised for it, removed on delete
  note      String?
  createdAt DateTime  @default(now())
  payments  Payment[] @relation("PaymentEntry")
  debtPayments DebtPayment[]
  chargedPayments Payment[] @relation("PaymentCharge")
  // Set on a debt Entry created automatically from a linked Plaid credit
  // card / loan account.
  plaidAccount PlaidAccount? @relation("PlaidAccountEntry")
  // Same, for a card/loan synced through SimpleFIN.
  simplefinAccount SimplefinAccount? @relation("SimplefinAccountEntry")

  @@index([userId])
  @@index([debtEntryId])
}

model Payment {
  id          String   @id @default(cuid())
  entryId     String
  entry       Entry    @relation("PaymentEntry", fields: [entryId], references: [id], onDelete: Cascade)
  month       String   // "YYYY-MM"
  fromBalance Boolean  @default(true)
  debtEntryId String?  // set when the bill was put on a credit card / debt
  debtEntry   Entry?   @relation("PaymentCharge", fields: [debtEntryId], references: [id], onDelete: SetNull)
  chargeId    String?  // the DebtPayment charge raised for it, removed on unpay
  paidAt      DateTime @default(now())

  @@unique([entryId, month])
  @@index([entryId])
  @@index([debtEntryId])
}

model DebtPayment {
  id      String   @id @default(cuid())
  entryId String
  entry   Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  amount      Float
  kind        String  @default("payment") // "payment" | "charge"
  fromBalance Boolean @default(true) // payments only: whether it came out of tracked balance
  note        String?
  paidAt  DateTime @default(now())

  @@index([entryId])
}

// One Plaid Link "Item" = one login at one institution. A user can connect
// several (different banks, or a second login at the same bank).
model PlaidItem {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId          String   @unique // Plaid's item_id
  // AES-256-GCM ciphertext (see lib/plaid-crypto.ts) — never store this raw.
  accessToken     String
  institutionId   String?
  institutionName String?
  cursor          String? // transactions/sync cursor; null means "never synced"
  status          String   @default("active") // "active" | "error"
  error           String?
  createdAt       DateTime @default(now())
  accounts        PlaidAccount[]
  transactions    PlaidTransaction[]

  @@index([userId])
}

model PlaidAccount {
  id           String    @id @default(cuid())
  plaidItemId  String
  plaidItem    PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  accountId    String    @unique // Plaid's account_id
  name         String
  mask         String?
  type         String    // Plaid account type: "depository" | "credit" | "loan" | ...
  subtype      String?
  // Only set for credit/loan accounts, which get mirrored into a debt Entry.
  // Depository (checking/savings) accounts have no Entry of their own —
  // their balance is surfaced directly and their transactions import as
  // purchase Entries (see lib/plaid-sync.ts).
  entryId      String?   @unique
  entry        Entry?    @relation("PlaidAccountEntry", fields: [entryId], references: [id], onDelete: SetNull)
  // Last balance we saw, so the next sync can compute a charge/payment delta
  // for debt accounts instead of overwriting the Entry's amount outright.
  lastBalance  Float?
  lastSyncedAt DateTime?

  @@index([plaidItemId])
}

// Plaid transaction ids already imported as purchase Entries, so re-syncing
// never duplicates one. Kept in its own table rather than as a unique column
// on Entry: adding a unique constraint to an existing, populated table makes
// `prisma db push` stop for data-loss confirmation, which fails the deploy.
// The row outlives the Entry on purpose — deleting an imported purchase
// shouldn't make the next sync bring it back.
model PlaidTransaction {
  transactionId String    @id // Plaid's transaction_id
  plaidItemId   String
  plaidItem     PlaidItem @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@index([plaidItemId])
}

// A SimpleFIN Bridge connection (simplefin.org): an alternative to Plaid for
// banks Plaid doesn't cover. One connection can hold several banks — they're
// all managed on the SimpleFIN site, behind one Access URL.
model SimplefinConnection {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // AES-256-GCM ciphertext of the Access URL, which embeds its own Basic
  // Auth credentials (see lib/plaid-crypto.ts) — never store this raw.
  accessUrl    String
  status       String    @default("active") // "active" | "error"
  error        String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  accounts     SimplefinAccount[]
  transactions SimplefinTransaction[]

  @@index([userId])
}

model SimplefinAccount {
  id           String              @id @default(cuid())
  connectionId String
  connection   SimplefinConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accountId    String // SimpleFIN account id — only unique within a connection
  orgName      String?
  name         String
  currency     String
  // SimpleFIN doesn't report account types, so this starts as a guess (see
  // guessKind in lib/simplefin.ts) and the user can change it:
  // "cash" imports spending as purchases, "debt" mirrors into a debt Entry,
  // "ignore" skips the account.
  kind         String
  entryId      String?  @unique
  entry        Entry?   @relation("SimplefinAccountEntry", fields: [entryId], references: [id], onDelete: SetNull)
  // Amount owed (debt) or balance (cash) at the last sync; debt syncs record
  // the change as a charge/payment instead of overwriting the Entry.
  lastBalance  Float?
  lastSyncedAt DateTime?

  @@unique([connectionId, accountId])
  @@index([connectionId])
}

// Transactions already imported as purchases. SimpleFIN ids are only unique
// within an account, so the key is "<account row id>:<transaction id>".
model SimplefinTransaction {
  key          String              @id
  connectionId String
  connection   SimplefinConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  @@index([connectionId])
}
