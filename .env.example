DATABASE_URL="postgresql://user:password@localhost:5432/debt_tracker"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:5000"

# Plaid — dashboard.plaid.com/team/keys. PLAID_SECRET is per-environment
# (a different value for sandbox vs production); PLAID_CLIENT_ID is shared.
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox" # sandbox | development | production
# Required products limit which banks can be linked; keep this minimal.
PLAID_PRODUCTS="transactions"
# Used where the bank supports it (card APR, minimum payment, due date).
PLAID_OPTIONAL_PRODUCTS="liabilities"
PLAID_COUNTRY_CODES="CA" # comma-separated, e.g. "CA,US"
# 32-byte key (hex or base64) used to encrypt stored Plaid access tokens.
# Generate with: openssl rand -hex 32
PLAID_TOKEN_ENCRYPTION_KEY="generate-with: openssl rand -hex 32"
